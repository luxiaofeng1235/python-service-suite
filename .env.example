# ==================== JWT / 安全 ====================
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== 服务 ====================
HOST=0.0.0.0
PORT=8000

# ==================== 数据库 ====================
# 开发环境（SQLite）：
DATABASE_URL=sqlite+aiosqlite:///./app.db
# 生产环境（MySQL）：
# DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/fastapi_ai?charset=utf8mb4
# 是否启动时自动 create_all；推荐使用 Alembic 后保持 False
AUTO_CREATE_TABLES=False

# ==================== Redis（可选）====================
# 本机直接运行 uvicorn 时使用：
# REDIS_URL=redis://localhost:6379/0
# docker compose 运行时由 docker-compose.yml 默认注入：
# DOCKER_REDIS_URL=redis://redis:6379/0

# ==================== 项目信息 ====================
PROJECT_NAME=FastAPI AI Service
VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO
LOG_DIR=./logs
SLOW_REQUEST_MS=1000

# 英文逗号分隔，路径前缀匹配
AUTH_WHITE_LIST=/,/docs,/redoc,/openapi.json,/favicon.ico,/api/health,/api/user/login,/api/user/register,/api/user/forgot-password,/api/user/reset-password,/api/ai/chat,/api/ai/chat/stream

# ==================== 上传 ====================
UPLOAD_DIR=./uploads

# ==================== 千问 / DashScope ====================
QWEN_API_KEY=your-qwen-api-key
QWEN_CHAT_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen-max

# ==================== 邮件（SMTP）配置 ====================
# QQ 邮箱示例（需开启 SMTP 服务，使用授权码）：
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-smtp-authorization-code
# SMTP_SENDER=可选，默认同 SMTP_USER
# SMTP_SENDER_NAME=可选，默认同 PROJECT_NAME
# 密码重置验证码过期时间（分钟）
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# 前端重置密码页面地址
RESET_PASSWORD_BASE_URL=http://localhost:3000/reset-password

# ==================== 第三方 API 密钥 ====================
# AI 模型 API Key 等敏感信息在此添加
# OPENAI_API_KEY=your-openai-api-key
